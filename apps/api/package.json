{
  "name": "@clipforge/api",
  "version": "1.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node ../../scripts/dev-api.cjs",
    "start": "node dist/main.js",
    "worker:ai": "tsx src/workers/pipeline.worker.ts",
    "worker:render": "tsx src/workers/render.worker.ts",
    "worker:publish": "tsx src/workers/publish.worker.ts",
    "worker:scheduler": "tsx src/workers/scheduler.worker.ts",
    "worker:recovery": "tsx src/workers/recovery.worker.ts",
    "test": "vitest run --root ../.. --config tests/vitest.config.ts",
    "test:integration": "vitest run --root ../.. --config tests/vitest.integration.config.ts",
    "worker:all": "bash scripts/run-workers.sh",
    "predev": "node ../../scripts/dev-api.cjs --check && npm run build -w @clipforge/validation -w @clipforge/platform-connectors -w @clipforge/database",
    "prebuild": "npm run build -w @clipforge/validation -w @clipforge/platform-connectors -w @clipforge/database",
    "pretypecheck": "npm run build -w @clipforge/validation -w @clipforge/platform-connectors -w @clipforge/database",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@clipforge/database": "1.0.0",
    "@clipforge/platform-connectors": "1.0.0",
    "@clipforge/shared-types": "1.0.0",
    "@clipforge/validation": "1.0.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "7.4.2",
    "argon2": "0.41.1",
    "bullmq": "5.34.10",
    "compression": "^1.8.2",
    "cookie-parser": "1.4.7",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.3.0",
    "ioredis": "5.4.2",
    "ipaddr.js": "2.2.0",
    "multer": "2.5.0",
    "nodemailer": "6.9.16",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/multer": "2.0.0",
    "@types/node": "20.17.10",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "6.0.2",
    "supertest": "7.1.3",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vitest": "2.1.8"
  }
}
