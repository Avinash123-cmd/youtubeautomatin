# ===========================================================================
# ClipForge AI — environment inventory.
# Configure the startup-required group and the selected storage driver.
# Feature credentials are optional unless that feature is enabled; see docs/foundation-audit.md.
# Any missing value that a feature needs produces
# "Configuration required — processing cannot start." in the UI/API.
# ===========================================================================

# Replace every example.com origin with your own before deployment. These placeholders are not
# operational endpoints; never use them as a production CORS allow-list or OAuth callback.
# Local development: change NODE_ENV=development, APP_URL=http://localhost:3000,
# ALLOWED_ORIGINS=http://localhost:3000. If you browse via 127.0.0.1, explicitly
# add http://127.0.0.1:3000 to ALLOWED_ORIGINS as a separate comma-separated origin.
# Never use ALLOWED_ORIGINS=*; Host and X-Forwarded-Host do not authorize origins.
# The API loads this repository-root .env independently of the working directory;
# environment values injected by Docker/the host take precedence.
# --- Runtime -------------------------------------------------------------
# In production DATABASE_URL and REDIS_URL must use reachable service hosts, never loopback.
NODE_ENV=production
APP_URL=https://app.example.com          # public origin of the web app (HTTPS in prod)
API_PORT=4000
# Per-dependency readiness probe deadline (100–30000 ms).
HEALTHCHECK_TIMEOUT_MS=5000
# Must be less than the container stop grace period. In-flight leases recover after a forced stop.
WORKER_SHUTDOWN_GRACE_MS=30000
# Proxies in front of the API. 1 for Render/Vercel/nginx; 0 when the API is directly exposed.
TRUST_PROXY=1
# Serve the OpenAPI document in production too (off by default: it lists every admin route).
API_DOCS_ENABLED=false
WEB_PORT=3000
ALLOWED_ORIGINS=https://app.example.com        # exact origins, no trailing slash; local dev: http://localhost:3000,http://127.0.0.1:3000
TIMEZONE=Asia/Kolkata                       # explicit; no implicit server TZ
LOG_LEVEL=info

# Optional host ports used by docker-compose.dev.yml. Change these when a local service already
# occupies a default port; if WEB_HOST_PORT changes, update APP_URL, ALLOWED_ORIGINS and
# STORAGE_LOCAL_PUBLIC_BASE_URL to the same local web origin.
WEB_HOST_PORT=3000
API_HOST_PORT=4000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
AI_ENGINE_HOST_PORT=8100
VIDEO_PROCESSOR_HOST_PORT=8200

# --- Persistence ---------------------------------------------------------
DATABASE_URL=postgresql://clipforge:CHANGE_ME@postgres:5432/clipforge?schema=public  # local dev example: postgresql://clipforge:clipforge@127.0.0.1:5432/clipforge?schema=public
REDIS_URL=redis://redis:6379  # local dev: redis://127.0.0.1:6379
REDIS_PREFIX=clipforge

# --- Cryptography --------------------------------------------------------
# 32-byte base64. Used for AES-256-GCM encryption of OAuth tokens at rest.
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# 32+ char secret used to HMAC session ids and CSRF tokens.
# Generate: openssl rand -hex 32
SESSION_SECRET=

# --- Object storage ------------------------------------------------------
# STORAGE_DRIVER must be explicit: "s3" (AWS S3 / Cloudflare R2) or "local".
# Example local-driver settings for a host with a persistent disk.
# Mount persistent storage at /var/data; objects below are NOT an anonymous static directory.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/data/clipforge/objects
STORAGE_LOCAL_PUBLIC_BASE_URL=https://api.example.com/media
# Local dev alternatives: STORAGE_LOCAL_ROOT=./.local-storage
# STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:4000/media
# Private media uses authenticated /media/sources/:sourceId and /media/clips/:variantId.
# /media/health/probe.mp4 is public; /media/<storage-key> is NOT a file-serving route.
# Render free/ephemeral storage is not durable; see docs/render-local-storage.md.
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Optional for custom endpoints; Compose uses S3_ENDPOINT by default for the web CSP build.
UPLOAD_CSP_ORIGINS=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Browser playback uses authenticated /media ID routes even with a private S3 bucket.
# Optional legacy public-distribution base; Instagram now uses short-lived signed S3 GET URLs.
# Do not make the source bucket public just to enable dashboard previews.
S3_PUBLIC_BASE_URL=

# --- AI providers --------------------------------------------------------
# No provider/model fallback exists. Both must be set or AI stages fail closed.
AI_PROVIDER=gemini
# ------------------------- Telegram notifications -------------------------
# REQUIRED in production: bot token, username and webhook secret (Telegram-only login).
# Chat ID is optional and used only for outbound notifications.
# Outbound notifications require TELEGRAM_BOT_TOKEN and a chat id (env or dashboard override).
# Inbound webhook control requires TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME, and TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
# Optional identity pin; checked against the token prefix and Telegram getMe. Not a secret.
TELEGRAM_BOT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=5000
TELEGRAM_MAX_ATTEMPTS=3

# ---- Legacy SMTP configuration (NOT an active sign-in/recovery method) ----
# Leave blank to run without email: the OTP email channel then reports itself unavailable instead of
# pretending to deliver. Any SMTP relay works (Brevo free tier, Mailtrap, Gmail app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ClipForge <no-reply@example.com>

# ---- One-time code policy ----
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Optional: dedicated HMAC secret for code hashing. Falls back to SESSION_SECRET.
OTP_SECRET=

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
WORK_DIR=/var/lib/clipforge/work  # local dev: ./.local-work
# Chunk size advertised to the browser. Lower it to 3 when a proxy in front of the API buffers
# request bodies (Vercel functions cap at 4.5 MB). S3/R2 multipart parts must stay >= 5 MiB.
UPLOAD_PART_SIZE_MIB=16
AI_ENGINE_URL=http://ai-engine:8100  # local dev: http://127.0.0.1:8100 (if running)
AI_ENGINE_API_KEY=
# Maximum expensive AI requests running at once per Python process (1-32).
AI_ENGINE_MAX_CONCURRENT_WORK=1

# --- Video processing ----------------------------------------------------
VIDEO_PROCESSOR_URL=http://video-processor:8200  # local dev: http://127.0.0.1:8200 (if running)
VIDEO_PROCESSOR_API_KEY=
# Maximum concurrent render/validation/audio jobs per Python process (1-32).
VIDEO_PROCESSOR_MAX_CONCURRENT_WORK=1
# Separate concurrent ffprobe limit, so renders cannot block uploads (1-32).
VIDEO_PROCESSOR_MAX_CONCURRENT_PROBES=2
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Python services use WORK_DIR too; there is no AI_ENGINE_WORK_DIR setting.

# --- YouTube source import -------------------------------------------------
# Pasting a YouTube URL is a real ingest path: the pipeline worker downloads the original media
# with yt-dlp, probes it with ffprobe and stores it exactly like an upload. Every source still
# requires an explicit rights declaration from the user, which is audited.
YOUTUBE_IMPORT_ENABLED=true
# Absolute path or PATH name. Inside the Docker image it is /usr/local/bin/yt-dlp.
YTDLP_PATH=yt-dlp
# Highest rendition downloaded before the 9:16 crop (360-2160).
YOUTUBE_IMPORT_MAX_HEIGHT=1080
YOUTUBE_IMPORT_TIMEOUT_SECONDS=1800
YOUTUBE_IMPORT_MAX_FILESIZE_MB=2048
# Optional: Netscape cookie file for videos that need a signed-in session (age-restricted, bot check).
# Keep it outside the repository and readable only by the API/worker user.
YOUTUBE_COOKIES_FILE=
# Optional outbound proxy for YouTube requests, e.g. http://user:pass@proxy:8080
YOUTUBE_PROXY=
# Optional: directory containing the ffmpeg/ffprobe binaries yt-dlp should use when merging streams.
YOUTUBE_YTDLP_FFMPEG_LOCATION=

# --- Platform connectors -------------------------------------------------
# OAuth credentials used to *publish* clips to your own channels.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://app.example.com/api/accounts/youtube/callback

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_REDIRECT_URI=https://app.example.com/api/accounts/instagram/callback

# --- Queue / workers -----------------------------------------------------
WORKER_CONCURRENCY_AI=2
WORKER_CONCURRENCY_RENDER=1
WORKER_CONCURRENCY_PUBLISH=2
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=20

# --- Deployment / operations -------------------------------------------------
# Public hostname Caddy obtains a certificate for (production compose only).
CLIPFORGE_DOMAIN=
# Contact address for ACME certificate-expiry notices.
ACME_EMAIL=
# Legacy public-distribution alias (optional, NOT required for signed private S3 media delivery).
STORAGE_PUBLIC_BASE_URL=
# PostgreSQL backup cadence and retention (the backup service runs inside the prod compose stack).
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

# --- Test-only switches ------------------------------------------------------
# TEST_MODE=1 unlocks the deterministic fixture AI provider. It must stay 0 in production, and
# AI_PROVIDER must be 'gemini' there. Fixture output is prefixed so it can never be mistaken
# for a model result.
TEST_MODE=0

# --- Telegram Bot-only authentication ------------------------------------
# The existing TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_USERNAME and TELEGRAM_WEBHOOK_SECRET
# are now the only authentication provider credentials. All three are required in production.
# Public HTTPS URL (local development: your authenticated HTTPS tunnel + exact path).
# TELEGRAM_WEBHOOK_URL=https://your-public-host/api/auth/telegram/webhook
# Existing OTP_* policy above is reused for optional Telegram security actions.
TELEGRAM_LOGIN_CHALLENGE_TTL_SECONDS=300

# Frontend-only BUILD INPUT (Vercel root directory apps/web). Public origin, never a secret.
# Overrides committed apps/web/api-target.json. Redeploy after changing.
API_INTERNAL_URL=https://api.example.com

# Optional official YouTube public metadata lookup (never downloads video/captions).
# Enable YouTube Data API v3 in the owning Google Cloud project and restrict this key.
YOUTUBE_DATA_API_KEY=

# Temporary LOCAL development only. Never enabled in production/hosted runtimes.
# Set AUTH_BYPASS=true in BOTH the API and Next dev environments, then restart.
# API also requires loopback DATABASE_URL and an EXISTING sandbox membership;
# the selected workspace slug must start with dev-auth-bypass-.
AUTH_BYPASS=false
AUTH_BYPASS_USER_ID=
AUTH_BYPASS_WORKSPACE_ID=
